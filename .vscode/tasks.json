{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "(Windows) 00. Remove build, vcpkg and vcpkg_installed folders",
      "type": "shell",
      "command": "cmake -E remove_directory build && cmake -E remove_directory vcpkg && cmake -E remove_directory vcpkg_installed",
    },
    {
      "label": "(Windows) 03. Install vcpkg",
      "type": "shell",
      "command": "git clone --branch 2024.06.15 --single-branch https://github.com/microsoft/vcpkg && .\\vcpkg\\bootstrap-vcpkg.bat && .\\vcpkg\\vcpkg install --triplet=x64-windows"
    },
    {
      "label": "(Windows) 05. Clean console",
      "type": "shell",
      "command": "cls",
    },
    {
      "label": "(Windows) 10. Configure",
      "type": "shell",
      "command": "cmake -S . -B build --preset use_vcpkg",
      "dependsOn": [
        "(Windows) 00. Clean console"
      ]
    },
    {
      "label": "(Windows) 20. Build",
      "type": "shell",
      "command": "cmake --build build -- -k 0", // stop on first error
      // "command": "cmake --build build", // continue on error
      "dependsOn": [
        "(Windows) 10. Configure"
      ]
    }
  ]
}




